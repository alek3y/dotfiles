# Useful for learning
#set-option -add global autoinfo normal

set-option -add global ui_options terminal_assistant=cat
set-option -add global ui_options terminal_set_tilte=false
set-option global startup_info_version -1
set-option global scrolloff 3,6
set-option global tabstop 2
set-option global indentwidth 0

add-highlighter -override global/ number-lines
add-highlighter -override global/ show-matching
add-highlighter -override global/ wrap
add-highlighter -override global/show-trailing-whitespaces regex "\h+$" 0:Error
add-highlighter -override global/ show-whitespaces -tab "┊" -lf " " -spc " " -nbsp " "

colorscheme tomorrow-night
set-face global LineNumbersWrapped +di@LineNumbers
set-face global MatchingChar +u

#set-option global modelinefmt %{ %val{bufname} {{context_info}} |  {{mode_info}}  }
